# Copia este archivo a .streamlit/secrets.toml y pon tu clave real:
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml      # Linux/macOS
#   copy .streamlit\secrets.toml.example .streamlit\secrets.toml    # Windows
#
# .streamlit/secrets.toml está en .gitignore: no se sube nunca al repositorio.
#
# Si no creas secrets.toml, la app arranca igual y te pide la clave en la
# barra lateral (solo para esa sesión, no se guarda en disco).
#
# En Streamlit Community Cloud, define esta clave en los ajustes de la app
# (Settings → Secrets) en lugar de subir el archivo.

ANTHROPIC_API_KEY = "sk-ant-aqui-tu-clave"
